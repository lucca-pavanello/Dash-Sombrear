# Supabase — URL e anon key são públicas por design (RLS protege o banco)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# n8n — URL do webhook de cotação (exposta no bundle; adicionar Header Auth no n8n)
VITE_N8N_WEBHOOK=https://SEU_N8N_HOST/webhook/SEU_ENDPOINT

# Feature flags
VITE_FEATURE_AI_ESTOQUE=false

# ──────────────────────────────────────────────────────────────────────
# ATENÇÃO: as variáveis abaixo NÃO devem ter prefixo VITE_
# Em Vite, VITE_* é compilado no bundle e fica visível no browser.
# Manter sem prefixo (usadas apenas em scripts server-side/Edge Functions).
# ──────────────────────────────────────────────────────────────────────

# Gemini AI — usar apenas em Supabase Edge Function (não no frontend)
# GEMINI_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXX

# Google Sheets — usar apenas em Edge Function
# GOOGLE_SHEETS_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_SHEETS_ID=ID_DA_SUA_PLANILHA
# GOOGLE_SHEETS_GID=ID_DA_ABA

# n8n API — usar apenas em scripts server-side
# N8N_API_KEY=eyJ...

# Supabase Service Role — NUNCA expor no frontend
# SUPABASE_SERVICE_KEY=sbp_XXXXXXXXXXXXXXXXXXXXXXXX
